definition rbac/principal {}

definition rbac/group {
	relation t_direct_member: rbac/principal

	permission member = t_direct_member
}

definition rbac/role {
	relation t_can_get_k8s_configmap: rbac/principal:*
	relation t_can_update_k8s_configmap: rbac/principal:*
	relation t_can_any_k8s_configmap: rbac/principal:*

	relation t_k8s_role_cnv_view: rbac/principal:*
	permission k8s_role_cnv_view = t_k8s_role_cnv_view

	permission get_k8s_configmap = t_can_get_k8s_configmap + t_can_any_k8s_configmap
	permission update_k8s_configmap = t_can_update_k8s_configmap + t_can_any_k8s_configmap

}

definition rbac/role_binding {
	relation t_role: rbac/role
	relation t_subject: rbac/principal | rbac/group#member

	permission k8s_role_cnv_view = t_subject & t_role->k8s_role_cnv_view

	permission get_k8s_configmap = t_subject & t_role->get_k8s_configmap
	permission update_k8s_configmap = t_subject & t_role->update_k8s_configmap
}

definition k8s/cluster {
	relation t_binding: rbac/role_binding

	permission cnv_view = t_binding->k8s_role_cnv_view

	permission get_k8s_configmap = t_binding->get_k8s_configmap
	permission update_k8s_configmap = t_binding->update_k8s_configmap
}

definition k8s/namespace {
	relation t_cluster: k8s/cluster
	relation t_binding: rbac/role_binding

	permission cnv_view = t_binding->k8s_role_cnv_view + t_cluster->cnv_view

	permission get_k8s_configmap = t_binding->get_k8s_configmap + t_cluster->get_k8s_configmap
	permission update_k8s_configmap = t_binding->update_k8s_configmap + t_cluster->update_k8s_configmap
}

definition k8s/configmap {
	relation t_namespace: k8s/namespace
	relation t_binding: rbac/role_binding

	permission get = t_binding->get_k8s_configmap + t_namespace->get_k8s_configmap
	permission update = t_binding->update_k8s_configmap +t_namespace->update_k8s_configmap
}
